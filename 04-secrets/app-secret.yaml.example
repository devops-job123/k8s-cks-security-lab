# ===========================================
# TEMPLATE - Do not use real values here!
# ===========================================
# This is an EXAMPLE file to document how to create a Secret.
# The real app-secret.yaml is excluded from Git for security.
#
# Usage:
#   1. Copy this file:
#        cp app-secret.yaml.example app-secret.yaml
#   2. Replace placeholders with base64-encoded values:
#        echo -n 'your-password' | base64
#        echo -n 'your-api-key' | base64
#   3. Encrypt with kubeseal:
#        kubeseal --format yaml < app-secret.yaml > sealed-secret.yaml
#   4. Apply only the sealed secret:
#        kubectl apply -f sealed-secret.yaml
#   5. Verify decryption:
#        kubectl get secret app-secret -n secure-app -o jsonpath='{.data.password}' | base64 -d
#   6. Delete the plain secret (git ignores it):
#        rm app-secret.yaml
# ===========================================

apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: secure-app
type: Opaque
data:
  password: <BASE64_ENCODED_PASSWORD>
  api-key: <BASE64_ENCODED_API_KEY>
